# Optional. When set, Wander proxies foot-walking directions through /api/directions
# and Adelaide place autocomplete through /api/geocode (HeiGIT Pelias).
# Without this key the local grid geometry adapter is used and start search is unavailable.
# Never put this value in frontend code — server-only.
OPENROUTESERVICE_API_KEY=

# Browser key for the no-charge, unlimited Maps Embed API Street View mode.
# Restrict this key to Maps Embed API and your localhost/Vercel HTTP referrers.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Server-only Google Places key. Restrict it to Places API (New); never prefix it with NEXT_PUBLIC.
GOOGLE_PLACES_API_KEY=

# Add these when the Supabase project is ready. The service-role key must never be exposed here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
